# ==========================================
# CampusExchange Environment Variables Setup
# ==========================================

# Server Port (Render/Railway sets PORT automatically)
PORT=3000

# Client App URL (For CORS & Auth Cookie validation)
CLIENT_URL=http://localhost:5173

# Node Environment
NODE_ENV=production

# MongoDB Database Connection String
# Leave blank to use in-memory database mode automatically
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusexchange?retryWrites=true&w=majority

# JWT Token Secret Keys (Use long random strings)
JWT_ACCESS_SECRET=campusexchange_super_secret_access_key_2026_x987
JWT_REFRESH_SECRET=campusexchange_super_secret_refresh_key_2026_y654

# Google Gemini AI API Key (For AI price valuation & search auto-complete)
GEMINI_API_KEY=your_gemini_api_key_here
