# ============================================
# CampusExchange Frontend - Environment Variables
# ============================================
# Set these in Vercel Dashboard → Project → Settings → Environment Variables

# Your deployed backend API URL (from Render/Railway)
# Example: https://campusexchange-api.onrender.com/api
VITE_API_BASE_URL=https://your-backend.onrender.com/api

# Your deployed backend base URL (for Socket.io connections)
# Example: https://campusexchange-api.onrender.com
VITE_API_URL=https://your-backend.onrender.com
